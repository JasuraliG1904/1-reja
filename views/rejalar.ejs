<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
</head>

<body style="background-color:#b8bbd1;">
    <div class="container">
        <div class="display-4 text-center py-1">Reja</div>
        <form id="create-form" action="/create-item" method="Post">
            <div class="d-flex align-items-center">
                <input 
                id="create-field" 
                name="item"
                autofocus
                autocomplete="off"
                class="form-control mr-3"
                type="text" 
                style="flex: 1;"
                >
                <button class="btn btn-primary" style="border-radius: 20px">Yangi Rejalar Qo'shish</button>
            </div>
        </form>
        <button id="clean-all" class="btn btn-danger" style="border-radius: 20px; margin-top: 20px;">Hamma Rejalarni O'chirish</button>
    </div>

</body>

</html>