                    </div>
                    <div class="left_2-1">
                        <div style="background-color: #FFB400; padding: 3px;">Adress:</div>
                        <div>
                            <%=user.adress%>
                        </div>
                    </div>
                </div>
                <div class="marginer"></div>
                <div class="left_3">
                    <p>Languages</p>
                    <div class="left_3-1">
                        <div style="padding: 3px;">Bangla</div>
                        <div>100%</div>
                    </div>
                    <div class="progress-bar">
                        <div class="progress" style="width: 100%;"></div>
                    </div>
                    <div class="left_3-1">
                        <div style="padding: 3px;">English</div>
                        <div>80%</div>
                    </div>
                    <div class="progress-bar">
                        <div class="progress" style="width: 80%;"></div>
                    </div>
                    <div class="left_3-1">
                        <div style="padding: 3px;">Spanish</div>
                        <div>60%</div>
                    </div>
                    <div class="progress-bar">
                        <div class="progress" style="width: 60%;"></div>
                    </div>
                </div>
                <div class="marginer"></div>
                <div class="left_4">
                    <p>Skills</p>
                    <div class="left_4-1">
                        <div style="padding: 3px;">HTML</div>
                        <div>90%</div>
                    </div>
                    <div class="progress-bar">
                        <div class="progress" style="width: 90%;"></div>
                    </div>
                    <div class="left_4-1">
                        <div style="padding: 3px;">CSS</div>
                        <div>85%</div>
                    </div>
                    <div class="progress-bar">
                        <div class="progress" style="width: 85%;"></div>
                    </div>
                    <div class="left_4-1">
                        <div style="padding: 3px;">JS</div>
                        <div>80%</div>
                    </div>
                    <div class="progress-bar">
                        <div class="progress" style="width: 80%;"></div>
                    </div>
                    <div class="left_4-1">
                        <div style="padding: 3px;">PHP</div>
                        <div>75%</div>
                    </div>
                    <div class="progress-bar">
                        <div class="progress" style="width: 75%;"></div>
                    </div>
                    <div class="left_4-1">
                        <div style="padding: 3px;">WordPress</div>
                        <div>85%</div>
                    </div>
                    <div class="progress-bar">
                        <div class="progress" style="width: 85%;"></div>
                    </div>
                </div>
                <div class="marginer"></div>
                <div class="left_5">
                    <p>Extra Skills</p>
                    <div class="left_5-1">
                        <img src="images/Skill_icon.png" alt="">
